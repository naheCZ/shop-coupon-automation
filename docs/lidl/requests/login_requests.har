            "size": 177497,
            "mimeType": "text/html",
            "text": "\n<!DOCTYPE html>\n<html lang=\"cs-CZ\">\n<head>\n    <title>Lidl Plus účet</title>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link rel='icon' type='image/svg+xml' href='https://www.lidl.CZ/mla/layout/assets/logo.svg' sizes='16x16' />\n    \n<style>\n    @font-face {\n        font-family: 'Lidl-Font-Condensed-Bold';\n        font-style: normal;\n        font-weight: 700;\n        src: local(https://www.lidl.CZ/mla/layout/fonts/LidlFontCondPro/LidlFontCondPro-Bold.woff2) format('woff2');\n        src: url(https://www.lidl.CZ/mla/layout/fonts/LidlFontCondPro/LidlFontCondPro-Bold.woff2) format('woff2');\n    }\n\n    @font-face {\n        font-family: 'Lidl-Font-Condensed-SemiBold';\n        font-style: normal;\n        font-weight: 600;\n        src: local(https://www.lidl.CZ/mla/layout/fonts/LidlFontCondPro/LidlFontCondPro-Semibold.woff2) format('woff2');\n        src: url(https://www.lidl.CZ/mla/layout/fonts/LidlFontCondPro/LidlFontCondPro-Semibold.woff2) format('woff2');\n    }\n\n    @font-face {\n        font-family: 'Lidl-Font-Condensed';\n        font-style: normal;\n        font-weight: 400;\n        src: local(https://www.lidl.CZ/mla/layout/fonts/LidlFontCondPro/LidlFontCondPro-Regular.woff2) format('woff2');\n        src: url(https://www.lidl.CZ/mla/layout/fonts/LidlFontCondPro/LidlFontCondPro-Regular.woff2) format('woff2');\n    }\n\n    @font-face {\n        font-family: 'Lidl-Font-Italic';\n        font-style: normal;\n        font-weight: 400;\n        src: local(https://www.lidl.CZ/mla/layout/fonts/LidlFontCondPro/LidlFontCondPro-Italic.woff2) format('woff2');\n        src: url(https://www.lidl.CZ/mla/layout/fonts/LidlFontCondPro/LidlFontCondPro-Italic.woff2) format('woff2');\n    }\n</style>\n    <link rel=\"stylesheet\" href='https://www.lidl.CZ/mla/layout/bundles/styles.cb5c1ca080875.css' />\n\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"/cdn/assets/l